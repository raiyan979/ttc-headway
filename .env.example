# Copy to .env (gitignored) and fill in. All values are overridable at runtime.

# --- Storage ---
# Local staging directory the collector always writes to first.
TTC_STORAGE_ROOT=./data/raw

# --- Cloudflare R2 (only needed to publish to R2; leave blank for local-only) ---
# The bucket name, account ID, and endpoint are NOT secrets, but the repo is
# public, so they go through env vars too rather than into tracked files.
# Endpoint looks like: https://<account_id>.r2.cloudflarestorage.com
TTC_R2_BUCKET=
TTC_R2_ENDPOINT_URL=
TTC_R2_ACCESS_KEY_ID=
TTC_R2_SECRET_ACCESS_KEY=
